{
  "name": "forge3d",
  "version": "3.0.1",
  "private": true,
  "description": "Forge3D — Parametric 3D modeling IDE for OpenSCAD (Electron desktop app)",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test:node": "node --test scripts/*.test.mjs",
    "generate:start-previews": "node scripts/generate-start-previews.mjs",
    "capture:release-screenshot": "node scripts/capture-release-screenshots.mjs",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "postinstall": "electron-rebuild || echo 'Warning: electron-rebuild failed. Terminal may not work.'"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-csg-ts": "^3.2.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.forge3d.app",
    "productName": "Forge3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
